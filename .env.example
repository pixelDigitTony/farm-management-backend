NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/MissVBusiness
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Production only: allows public requests from https://*.yourdomain.com
# PUBLIC_SITE_BASE_DOMAIN=yourdomain.com
# Keep console while Resend is not configured.
EMAIL_PROVIDER=console
# Change EMAIL_PROVIDER to resend after completing both required values below.
RESEND_API_KEY=
RESEND_EMAIL_FROM=
RESEND_EMAIL_FROM_NAME=Miss V Business
# Production requires a public HTTPS FRONTEND_URL, EMAIL_PROVIDER=resend,
# the Resend key/from values above, and a separate 32+ character payload secret.
# Generate once and retain across restarts (do not commit the actual secret).
EMAIL_PAYLOAD_SECRET=
LANDING_ANALYTICS_ENABLED=true
# Enable after the dedicated receiving domain and webhook are verified in Resend.
ORDER_EMAIL_INBOX_ENABLED=false
# Domain only, such as replies.example.com; do not enter a mailbox like order@example.com.
EMAIL_RECEIVING_DOMAIN=
RESEND_WEBHOOK_SECRET=
ORDER_MESSAGE_RETENTION_DAYS=365
EMAIL_VERIFICATION_TTL_MINUTES=1440
CREDENTIAL_RESET_TTL_MINUTES=60
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_MAX_RESENDS_PER_HOUR=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.yourdomain.com
