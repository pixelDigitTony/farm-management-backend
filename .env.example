NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/MissVBusiness
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Keep console while Cloudflare Email Service is not configured.
EMAIL_PROVIDER=console
# Change EMAIL_PROVIDER to cloudflare after completing all three values below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_FROM_NAME=Miss V Business
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_MAX_RESENDS_PER_HOUR=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.yourdomain.com
